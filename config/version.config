# Applied by scripts/build-version.sh from official release metadata.
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="@@IMMORTALWRT_VERSION@@"
CONFIG_VERSION_CODE="@@IMMORTALWRT_REVISION@@"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/@@IMMORTALWRT_VERSION@@"
